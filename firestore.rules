rules_version = '2';

// Each signed-in user can read and write only their own data under users/{their uid}.
// Everyone else (including signed-out visitors) is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
